
QuitScreen, FormScreen {
    align: center middle;
}

Grid, Vertical {
    width: 50%;
    height: auto;
    background: $surface;
    padding: 1 2;
}

Label {
    width: 100%;
    text-align: center;
    padding: 0;
    padding-bottom: 1;
}

Button {
    width: 100%;
}

.form-screen-input:focus {
    background: red;
}

#quit-dialog {
    
    grid-size: 2;
    align: center middle;
    grid-gutter: 0 2;
}

#quit-label {
    column-span: 2;
    height: auto;
    width: 1fr;
    content-align: center middle;
}

InputWithBorder Input {
    padding: 0 1;
    margin: 0;
}

#form-screen-submit {
    margin-top: 1;
}

FormScreen #description, FormScreen #comment {
    padding: 1 0;
    height: auto;
    max-height: 5;
}

ListItem {
    padding-left: 1;
}

.card-label {
    text-align: left;
    padding-left: 1;
}

.card-not-started {
    background: #182e52
}

.card-started {
    background: #154717;
}

.card-delayed {
    background: #521a18;
}

.card-done {
    background: #4a4646;
}
.card-blocked {
    background: #73702a;
}

.card-skipped {
    background: #5c545b;
}

.card-deleted {
    background: #282928;
}



Footer {
    height: 2;
}
